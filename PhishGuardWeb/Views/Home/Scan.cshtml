@{
    ViewData["Title"] = "URL Scanner";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="pane shadow-sm p-4">
            <div class="pane-body text-center">
                <h1 class="mb-4"><i class="fas fa-search me-2"></i> URL Scanner</h1>
                <form method="post">
                    <div class="mb-3">
                        <input type="text" name="urlToCheck" placeholder="Enter URL to scan" class="form-control form-control-lg" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fas fa-check-circle me-2"></i> Scan
                    </button>
                </form>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-3" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.Error
                    </div>
                }
                @if (ViewBag.Verdict != null)
                {
                    <div class="alert alert-info mt-3" role="alert">
                        <strong><i class="fas fa-info-circle me-2"></i> Scan Verdict:</strong> @ViewBag.Verdict <br />
                        
                    </div>
                }

                @if (ViewBag.FullJson != null)
                {
                    <details class="mt-3">
                        <summary><i class="fas fa-code me-2"></i> Raw VirusTotal JSON</summary>
                        <pre class="text-start">@ViewBag.FullJson</pre>
                    </details>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Custom styles specific to the Index page for better fit on 15-inch display */
    

    .form-control-lg {
        padding: 0.6rem 1.2rem; /* Slightly reduce padding in the input */
        font-size: 1rem; /* Adjust font size if needed */
        border-radius: 0.5rem;
    }

    .btn-primary {
        padding: 0.6rem 1.2rem; /* Slightly reduce padding in the button */
        font-size: 1rem; /* Adjust font size if needed */
        border-radius: 0.5rem;
        font-weight: 500;
    }
    
    .pane {
        align-items:center;
    }

    .alert {
        border-radius: 0.5rem;
        padding: 1rem;
        font-size: 0.9rem; /* Adjust alert font size if needed */
    }

    details {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: 0.5rem;
        padding: 0.8rem; /* Slightly reduce padding in details */
        margin-top: 1.2rem; /* Slightly reduce top margin */
        text-align: left;
        font-size: 0.9rem; /* Adjust details font size if needed */
    }

    summary {
        font-weight: bold;
        color:rgb(43, 19, 78);
        cursor: pointer;
        padding-bottom: 0.4rem; /* Slightly reduce padding */
        font-size: 1rem; /* Adjust summary font size if needed */
    }

    pre {
        background-color:rgb(43, 19, 78);
        padding: 0.8rem; /* Slightly reduce padding in pre */
        border-radius: 0.375rem;
        overflow-x: auto;
        font-size: 0.8rem; /* Adjust pre font size if needed */
        white-space: pre-wrap;
        text-align: left;
    }
</style>