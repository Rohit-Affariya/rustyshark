@{
    ViewData["Title"] = "Home";
}

<div class="hero text-center d-flex flex-column justify-content-center align-items-center" style="height: 90vh; text-align: center; padding: 20px;">
    <h1 class="display-3 fw-bold mb-4 animate__animated animate__fadeInDown" style="background: linear-gradient(90deg, #00c6ff, #0072ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        Welcome to RustySharks
    </h1>
    <p class="lead animate__animated animate__fadeInUp" style="max-width: 700px; color: #cfd8dc;">
        Empowering you with cutting-edge tools to safeguard your digital life. Stay protected, stay ahead, with RustySharks' smart cybersecurity solutions.
    </p>
    <a href="/Home/Index" class="btn btn-primary btn-lg mt-4 animate__animated animate__fadeInUp" >
        Explore Tools
    </a>
</div>

<!-- For Scroll Button -->
