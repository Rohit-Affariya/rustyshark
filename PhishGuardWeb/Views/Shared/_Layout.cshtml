<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RustySharks</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PhishGuardWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" integrity="sha512-Fo3rlrZj/k7ujTnHg4CGR2D7kSs0v4LLanw2qksYuRlEzO+tcaEPQogQ0KaoGN26/zrn20ImR1DfuLWnOo7aBA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" integrity="sha512-9usAa10IRO0HhonpyAIVpjrylPvoDwiPUiKdWk5t3PyolY1cOd4DSE0Ga+ri4AuTroPR5aQvXU9xC6qOPnzFeg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <style>
        /* Override Bootstrap's container for a slightly narrower width on larger screens */
        body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding: 0;
        background: linear-gradient(to bottom, #030712, #4c1d95);
        color: #fff;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        overflow: hidden;
    }
        
        .container {
            max-width: 960px; /* Adjust this value as needed for your 15-inch screen */
            width: 90%; /* Allow it to be slightly smaller on smaller screens */
            margin-left: auto;
            margin-right: auto;
        }

        /* Make the navbar transparent */
        .navbar {
            background-color: transparent !important;
            height: 48px; /* Ensure enough height for alignment */
            width: 1536px
        }

        /* Style the logo with a color similar to the theme's gradient */
        .navbar-brand {
            font-size: 1.75rem; /* Larger brand font */
            font-weight: 600; /* Semi-bold brand */
            color: #4c1d95 !important; /* Use the darker color from your gradient */
            margin-right: 2rem; /* Increased right margin */
            display: flex; /* Enable flexbox for alignment */
            align-items: center; /* Vertically align icon and text */
        }

        .navbar-brand .fas {
            margin-right: 0.5rem; /* Space between icon and text */
        }

        .navbar-toggler {
            border: none !important;
            display: flex; /* Enable flexbox for alignment */
            align-items: center; /* Vertically align icon */
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg viewBox='0 0 30 30' xmlns='http://www.w3.org/2000/svg'%3e%3cpath stroke='rgba(76, 29, 149, 0.7)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        .navbar-nav {
            display: flex;
            align-items: center; /* Vertically align nav items */
            margin-left: auto; /* Push nav items to the right */
        }

        .navbar-nav .nav-item {
            margin-left: 1.5rem; /* Increased left margin between nav items */
            display: flex; /* Enable flexbox for alignment within each item */
            align-items: center; /* Vertically align icon and text within each item */
        }

        .navbar-nav .nav-link {
            color: #555 !important; /* Darker nav link color */
            padding: 0.75rem 1rem;
            transition: color 0.3s ease-in-out, background-color 0.3s ease-in-out; /* Added background transition */
            border-radius: 0.375rem; /* Rounded nav links */
            font-weight: 500; /* Medium font weight for nav links */
            display: flex; /* Enable flexbox for alignment */
            align-items: center; /* Vertically align icon and text */
        }

        .navbar-nav .nav-link .fas {
            margin-right: 0.5rem; /* Space between icon and text in nav links */
        }

        .navbar-nav .nav-link:hover,
        .navbar-nav .nav-link:active {
            color: #4c1d95 !important; /* Highlight on hover/active with theme color */
            background-color: rgba(76, 29, 149, 0.1); /* Light background on hover/active with theme color */
        }

        .navbar-nav .nav-item.active .nav-link {
            color: #4c1d95 !important;
            font-weight: 600; /* Bold active nav link */
            background-color: rgba(76, 29, 149, 0.1); /* Light background for active with theme color */
        }

        .navbar-collapse {
            margin-left: 43rem; /* Push to the right */
        }

        /* Make the footer transparent and position content to the bottom right */
        .footer {
            background-color: transparent !important;
            color: #666; /* Darker footer text */
            display: flex; /* Enable flexbox for positioning */
            justify-content: flex-end; /* Push content to the right */
            align-items: flex-end; /* Vertically align items */
            align-content: flex-end;
            width: 100%; /* Make the footer span the entire width */
            position: absolute; /* Position it absolutely at the bottom */
            bottom: 0;
            left: 0;
            right: 0;
            padding-bottom: 0%;
        }

        .footer a {
            color: #007bff;
            margin-left: 1rem;
            text-decoration: none;
            transition: color 0.2s ease-in-out;
        }

        .footer a:hover {
            color: #0056b3; /* Darker blue on hover */
            text-decoration: underline;
        }

        .card {

            align-items: flex-end;
            align-content: flex-end;
        }

        .card-body {
            width: 21rem;
            padding: 0;
        }
        

        .footer .container {
            margin: 0;
            padding: 0;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Landing">
                    <i class="fas fa-shield-alt me-2"></i> RustySharks
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Landing" asp-controller="Home">
                                <i class="fas fa-home me-2"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Index" asp-controller="Home">
                                <i class="fas fa-tools me-2"></i> Tools
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="History" asp-controller="Home">
                                <i class="fas fa-history me-2"></i> History
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="About" asp-controller="Home">
                                <i class="fas fa-info-circle me-2"></i> About
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-action="Contact" asp-controller="Home">
                                <i class="fas fa-envelope me-2"></i> Contact
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted mt-4" style="position: absolute; bottom: 0; left: 0; right: 0; background-color: #f8f9fa; color: #6c757d; padding: 0; text-align: center;">
        <div class="container">
            <div class="card" style="border: none; background-color: transparent;">
                <div class="card-body p-3 text-center">
                    &copy; 2025 - RustySharks - <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color: #007bff; margin-left: 0.5rem; text-decoration: none;">Privacy Policy</a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>